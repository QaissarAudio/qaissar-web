# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Local / Contabo VPS: use direct connection (port 5432).
# Supabase example:
#   postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
# Do NOT use Vercel/serverless pooler settings (port 6543 / pgbouncer) on a VPS.
DATABASE_URI=

# ── Payload CMS ─────────────────────────────────────────────────────
PAYLOAD_SECRET=

# Public site URL (no trailing slash). Required for admin, media, and API.
# Production example: https://qaissar.com
NEXT_PUBLIC_SERVER_URL=

# Optional: extra origins for Payload CORS/CSRF (comma-separated)
# PAYLOAD_ALLOWED_ORIGINS=https://www.qaissar.com

# First admin user (seed script only)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ── Runtime (Contabo / Node) ────────────────────────────────────────
NODE_ENV=production
PORT=3000
